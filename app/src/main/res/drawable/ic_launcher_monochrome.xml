<?xml version="1.0" encoding="utf-8"?>
<!--
    主题图标（Android 13 单色图标）用的版本：系统只取 alpha 上色。

    这里**不复用彩色前景**，而是「实心纸 + 折角挖空」：
    彩色前景把白色纸和深色字条叠在一起，转成单色会糊成一块；挖掉折角，
    图形上仍然一眼是「一张纸」，这在这个尺寸上已经是能表达的全部了。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M41,29 H58 L69,40 V69 a8,8 0 0 1 -8,8 H41 a8,8 0 0 1 -8,-8 V37 a8,8 0 0 1 8,-8z M58,29 L58,40 H69 Z" />
</vector>
