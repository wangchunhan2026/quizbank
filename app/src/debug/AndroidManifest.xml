<?xml version="1.0" encoding="utf-8"?>
<!--
    只在 debug 包里合并进去的清单。
    正式包（release）完全不包含这里的东西，所以 OcrProbeReceiver 和这个导出组件
    不会进到发给别人的 APK 里。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.daily.quizbank.probe.OcrProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.daily.quizbank.probe.OCR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
