<?xml version="1.0" encoding="utf-8"?>
<!--
    图标底色：深靛蓝 → 紫罗兰的对角渐变，再叠两团很淡的柔光。

    为什么用渐变而不是纯色：纯色圆角方块在任何启动器上都像「临时占位」；
    一层克制的渐变 + 一点角光，缩到桌面上 48dp 时也还有层次。
    两团光刻意压得很淡（0.06 / 0.12）—— 拉高就变成塑料感的高光，这档质感全靠「几乎看不见」。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="0"
                android:endX="104"
                android:endY="108">
                <item android:offset="0" android:color="#FF10193A" />
                <item android:offset="0.52" android:color="#FF2A1D57" />
                <item android:offset="1" android:color="#FF4A2C7F" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.06"
        android:pathData="M4,22 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0Z" />

    <path
        android:fillColor="#FF7C5CFF"
        android:fillAlpha="0.12"
        android:pathData="M44,96 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0Z" />
</vector>
